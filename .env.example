# Copy to .env (git-ignored) for `npm run dev` and `npm run dev:phone`. All variables are optional.

# The backend Vite forwards /api/, /admin/ and /static/ to: mtg_ledger_core's `manage.py runserver` by default,
# or another one, e.g. https://mtgledger.gabprojects.it (careful: reads and writes hit that database).
DJANGO_URL=http://127.0.0.1:8000
# Port of the Vite dev server.
VITE_PORT=5173
